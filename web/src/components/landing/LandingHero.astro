---
interface Props {
  lang?: "en" | "km";
}

const { lang = "en" } = Astro.props;

const copy = {
  en: {
    title: "Expand your AI coding agents with",
    subtitle: "56 skills, 24 specialist agents, and 16 production workflows you can install in one command. Safe merge updates keep your local changes.",
    getStarted: "Get started",
    github: "GitHub",
    command1: "bun add -d github:houching/agx-kit",
    out1: "✓ Downloaded toolkit\n✓ Installed .agents (skills, agents, workflows)\n✓ Wrote managed-file manifest",
    command2: "agx-kit update",
    out2: "Strategy: merge · Backup created\nUpdated 12 files · Preserved 3 local · 0 conflicts",
    command3: "/brainstorm auth options",
    out3: "Exploring 3 approaches before you write code...",
    docsLink: "/installation/",
  },
  km: {
    title: "ពង្រីកសមត្ថភាព AI coding agent របស់អ្នកជាមួយ",
    subtitle: "ជំនាញចំនួន 56, agent ឯកទេសចំនួន 24 និងលំហូរការងារកម្រិតផលិតកម្ម 16 ដំឡើងត្រឹមតែមួយពាក្យបញ្ជា។ អាប់ដេតដោយសុវត្ថិភាពតាមរយៈ merge-aware ដោយរក្សាទុកការកែប្រែក្នុងម៉ាស៊ីនរបស់អ្នក។",
    getStarted: "ចាប់ផ្តើម",
    github: "GitHub",
    command1: "bun add -d github:houching/agx-kit",
    out1: "✓ បានទាញយក toolkit\n✓ បានដំឡើង .agents (ជំនាញ, ភ្នាក់ងារ, លំហូរការងារ)\n✓ បានកត់ត្រា managed-file manifest",
    command2: "agx-kit update",
    out2: "យុទ្ធសាស្ត្រ៖ merge · បានបង្កើតការបម្រុងទុក\nបានធ្វើបច្ចុប្បន្នភាព ១២ ឯកសារ · រក្សាទុក ៣ ឯកសារក្នុងស្រុក · ០ ជម្លោះ",
    command3: "/brainstorm auth options",
    out3: "កំពុងស្វែងយល់ ៣ វិធីសាស្រ្តមុនពេលអ្នកសរសេរកូដ...",
    docsLink: "/km/installation/",
  },
}[lang];
---

<section class="container mx-auto w-full px-4 sm:px-6 lg:px-8">
  <div class="mx-auto grid w-full min-w-0 [grid-template-columns:minmax(0,1fr)] place-items-center gap-8 py-12 sm:py-16 md:py-24 lg:max-w-screen-xl">
    <div class="space-y-6 text-center max-w-full">
      <h1 class="mx-auto max-w-screen-md text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tight text-foreground leading-tight">
        {copy.title}{" "}
        <span class="text-brand">AGX Kit</span>
      </h1>

      <p class="mx-auto max-w-screen-sm text-base sm:text-lg md:text-xl text-muted-foreground leading-relaxed">
        {copy.subtitle}
      </p>

      <div class="flex flex-col items-center justify-center gap-3 sm:flex-row pt-2 w-full max-w-xs sm:max-w-none mx-auto">
        <a
          href={copy.docsLink}
          class="group/arrow inline-flex w-full sm:w-auto min-h-[44px] items-center justify-center gap-2 rounded-lg bg-zinc-900 text-zinc-50 hover:bg-zinc-800 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-zinc-200 px-6 py-3 text-base font-semibold shadow-xs transition-all no-underline"
        >
          <span>{copy.getStarted}</span>
          <svg class="size-5 transition-transform group-hover/arrow:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>

        <a
          href="https://github.com/houching/agx-kit"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-full sm:w-auto min-h-[44px] items-center justify-center gap-2 rounded-lg border border-border bg-card text-foreground hover:bg-muted px-6 py-3 text-base font-semibold shadow-xs transition-all no-underline"
        >
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
          <span>{copy.github}</span>
        </a>
      </div>
    </div>

    <!-- Terminal Window -->
    <div class="relative mt-4 sm:mt-8 w-full min-w-0 max-w-4xl">
      <div class="absolute top-4 left-1/2 h-36 w-[90%] -translate-x-1/2 rounded-full bg-brand/30 blur-3xl lg:-top-6 lg:h-72 pointer-events-none"></div>
      
      <div class="relative overflow-hidden rounded-xl border border-border border-t-brand/40 bg-code shadow-2xl">
        <div class="flex items-center gap-2 border-b border-code-border bg-code-title px-4 py-3">
          <span class="size-3 rounded-full bg-red-500/90 inline-block"></span>
          <span class="size-3 rounded-full bg-amber-500/90 inline-block"></span>
          <span class="size-3 rounded-full bg-emerald-500/90 inline-block"></span>
          <span class="ml-2 font-mono text-xs text-muted-foreground">terminal</span>
        </div>

        <pre class="overflow-x-auto p-4 sm:p-5 font-mono text-xs sm:text-sm leading-relaxed text-code-foreground md:p-6 md:text-[15px]"><code><span class="text-brand font-bold">$</span> {copy.command1}
<span class="text-muted-foreground">{copy.out1}</span>

<span class="text-brand font-bold">$</span> {copy.command2}
<span class="text-muted-foreground">{copy.out2}</span>

<span class="text-brand font-bold">▸</span> {copy.command3}
<span class="text-muted-foreground">{copy.out3}</span></code></pre>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-12 sm:h-16 bg-gradient-to-t from-code/90 to-transparent"></div>
      </div>
    </div>
  </div>
</section>

---
interface Props {
  type?: "info" | "warning" | "error" | "tip";
  title?: string;
}

const { type = "info", title } = Astro.props;

const styles = {
  info: {
    border: "border-blue-500/40 bg-blue-500/5",
    iconColor: "text-blue-400",
    badge: "ℹ️",
  },
  warning: {
    border: "border-amber-500/40 bg-amber-500/5",
    iconColor: "text-amber-400",
    badge: "⚠️",
  },
  error: {
    border: "border-red-500/40 bg-red-500/5",
    iconColor: "text-red-400",
    badge: "🚫",
  },
  tip: {
    border: "border-[var(--v-brand)]/40 bg-[var(--v-brand)]/5",
    iconColor: "text-[var(--v-brand)]",
    badge: "💡",
  },
};
const current = styles[type];
---

<div class={`not-content border-l-4 rounded-r-xl p-4 mb-6 ${current.border}`}>
  <div class="flex items-start gap-3">
    <span class="text-base select-none shrink-0 mt-0.5">{current.badge}</span>
    <div class="flex-1 min-w-0">
      {title && <h4 class="text-sm font-semibold text-[var(--v-text)] mb-1">{title}</h4>}
      <div class="text-sm leading-relaxed text-[var(--v-text-2)] [&>p]:mb-0">
        <slot />
      </div>
    </div>
  </div>
</div>

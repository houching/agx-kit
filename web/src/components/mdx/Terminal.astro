---
interface Props {
  title?: string;
}

const { title = "agent-session" } = Astro.props;
---

<div class="not-content terminal-window rounded-xl border border-[var(--v-code-border)] bg-[var(--v-code-bg)] mb-8 overflow-hidden shadow-2xl">
  <!-- Window chrome -->
  <div class="flex items-center gap-2 px-4 py-2.5 border-b border-[var(--v-code-border)] bg-[var(--v-code-title)]">
    <div class="flex gap-1.5 items-center">
      <span class="w-3 h-3 rounded-full bg-red-500/90 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-amber-500/90 inline-block"></span>
      <span class="w-3 h-3 rounded-full bg-emerald-500/90 inline-block"></span>
    </div>
    <span class="ml-2 font-mono text-xs text-[var(--v-text-3)]">{title}</span>
  </div>
  <!-- Body -->
  <div class="p-5 font-mono text-sm leading-relaxed text-[var(--v-code-fg)] overflow-x-auto">
    <slot />
  </div>
</div>
